# Opcional: clave de Anthropic. Sin ella, el agente usa reglas locales.
ANTHROPIC_API_KEY=

# Adafruit IO: lecturas publicadas por el ESP32.
ADAFRUIT_IO_USERNAME=
ADAFRUIT_IO_KEY=
ADAFRUIT_IO_BPM_FEED=bpm
ADAFRUIT_IO_SPO2_FEED=oxigenacion
ALERTA_BPM_MIN=60
ALERTA_BPM_MAX=100
ALERTA_SPO2_MIN=95

# Opcional: URL privada del endpoint SheetDB para consultar la alerta
# registrada del pastillero. No compartas ni publiques la URL si es privada.
SHEETDB_API_URL=
